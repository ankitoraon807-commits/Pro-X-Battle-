<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PRO X Battle Tournament</title>

    <!-- Icons, Fonts, and Libraries -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://zapupi.com/single-html-web-kit.js"></script>

    <style>
        /* --- CSS Styles (Esports Dynamic Theme) --- */
        :root {
            --primary-bg: #05070A; 
            --secondary-bg: #0D111A; 
            --card-bg: #111622;
            --text-primary: #FFFFFF; 
            --text-secondary: #8B94A7; 
            --accent-color: #8B5CF6; 
            --accent-gradient: linear-gradient(135deg, #8B5CF6, #3B82F6); 
            --primary-button-bg: #8B5CF6; 
            --border-color: rgba(255, 255, 255, 0.08); 
            --bottom-nav-bg: #0B0E14; 
            --success-color: #10B981; 
            --danger-color: #EF4444;
            --warning-color: #F59E0B; 
            --info-color: #3B82F6;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html { font-size: 16px; scroll-behavior: smooth; overflow-x: hidden; }
        body { 
            font-family: 'Poppins', sans-serif; 
            background-color: var(--primary-bg); 
            color: var(--text-primary); 
            padding-top: 75px; 
            padding-bottom: 65px; 
            min-height: 100vh; 
            overflow-x: hidden; 
        }
        
        h1, h2, h3, h4, h5, h6, .font-orbitron, .section-title { font-family: 'Orbitron', sans-serif; }
        a { color: var(--accent-color); text-decoration: none; transition: 0.3s; } 
        a:hover { color: #A78BFA; }

        .main-content { padding: 15px; max-width: 600px; margin: 0 auto; } 
        .section { display: none; animation: scaleIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); } 
        .section.active { display: block; } 
        
        @keyframes scaleIn { 
            0% { opacity: 0; transform: translateY(15px) scale(0.98); } 
            100% { opacity: 1; transform: translateY(0) scale(1); } 
        }
        
        .section-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 18px; color: var(--text-primary); letter-spacing: 0.5px; display: flex; align-items: center; gap: 8px;} 
        .section-title::before { content:''; display:block; width: 4px; height: 18px; background: var(--accent-gradient); border-radius: 4px; }
        
        .custom-card { background-color: var(--card-bg); border-radius: 16px; padding: 18px; border: 1px solid var(--border-color); box-shadow: 0 4px 20px rgba(0,0,0,0.3); transition: 0.3s; } 
        
        .btn-custom { border-radius: 10px; font-size: 0.9rem; font-weight: 600; padding: 10px 18px; border: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer;} 
        .btn-custom-primary { background: var(--accent-gradient); color: #fff; box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3); } 
        .btn-custom-primary:active { transform: scale(0.96); box-shadow: 0 2px 8px rgba(139, 92, 246, 0.2); } 
        .btn-custom-secondary { background-color: rgba(255,255,255,0.05); color: var(--text-primary); border: 1px solid var(--border-color); } 
        .btn-custom-secondary:active { transform: scale(0.96); background-color: rgba(255,255,255,0.1); } 
        
        .text-accent { color: var(--accent-color); } .text-success { color: var(--success-color); } .text-danger { color: var(--danger-color); } .text-warning { color: var(--warning-color); } 
        
        /* Modern Inputs */
        .form-control { background-color: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 12px; padding: 12px 16px; transition: 0.3s; } 
        .form-control:focus { background-color: rgba(0,0,0,0.5); border-color: var(--accent-color); color: var(--text-primary); box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15); } 
        .form-control::placeholder { color: var(--text-secondary); opacity: 0.8; font-weight: 400; } 
        .form-label { color: var(--text-secondary); font-size: 0.85rem; font-weight: 500; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;} 
        
        #globalLoaderEl { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(5, 7, 10, 0.9); backdrop-filter: blur(10px); display: flex; justify-content: center; align-items: center; z-index: 99999; display: none; } 
        .spinner-border { color: var(--accent-color); width: 3rem; height: 3rem; border-width: 3px; } 

        /* ==========================================
           ANDROID NOTIFICATION CONTAINER
           ========================================== */
        #androidNotificationContainer { position: fixed; top: 15px; left: 0; right: 0; z-index: 99999; display: flex; flex-direction: column; align-items: center; pointer-events: none; padding: 0 12px; }
        .android-notif-card { width: 100%; max-width: 420px; background: rgba(17, 22, 34, 0.95); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid var(--border-color); box-shadow: 0 10px 40px rgba(0,0,0,0.8), 0 0 20px rgba(139, 92, 246, 0.15); border-radius: 16px; padding: 14px 16px; color: #ffffff; margin-bottom: 10px; pointer-events: auto; cursor: pointer; position: relative; overflow: hidden; transform: translateY(-120%); opacity: 0; transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.3s ease; }
        .android-notif-card.show { transform: translateY(0); opacity: 1; }
        .android-notif-card.hide { transform: translateY(-120%); opacity: 0; transition: transform 0.3s ease-in, opacity 0.2s ease-in; }
        .android-notif-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
        .android-notif-app-info { display: flex; align-items: center; gap: 8px; }
        .android-notif-icon { width: 24px; height: 24px; background: var(--accent-gradient); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; color: #fff; box-shadow: 0 2px 8px rgba(139, 92, 246, 0.4); }
        .android-notif-app-name { font-size: 0.75rem; font-weight: 700; color: #A1A1AA; letter-spacing: 0.5px; text-transform: uppercase; font-family: 'Orbitron', sans-serif;}
        .android-notif-time { font-size: 0.7rem; color: #64748b; font-weight: 500; }
        .android-notif-body { padding-left: 2px; }
        .android-notif-title { font-size: 0.95rem; font-weight: 700; color: #f8fafc; margin-bottom: 4px; line-height: 1.2; }
        .android-notif-message { font-size: 0.82rem; color: #cbd5e1; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

        /* LOGO ANIMATIONS & BADGES */
        .logo-container-anim { display: inline-flex; align-items: center; justify-content: center; }
        .logo-text-prox { font-weight: 800; font-style: italic; letter-spacing: 0.5px; background: linear-gradient(90deg, #ffffff, #8b5cf6, #ffffff); background-size: 200% auto; color: transparent; -webkit-background-clip: text; background-clip: text; animation: shineText 3s linear infinite; }
        .logo-text-battle { font-weight: 800; font-style: italic; letter-spacing: 0.5px; color: #ef4444; text-shadow: 0 0 8px rgba(239, 68, 68, 0.5); animation: pulseBattle 1.5s ease-in-out infinite alternate; }
        @keyframes shineText { to { background-position: 200% center; } }
        @keyframes pulseBattle { 0% { text-shadow: 0 0 5px rgba(239, 68, 68, 0.5); transform: scale(1); } 100% { text-shadow: 0 0 15px rgba(239, 68, 68, 0.9), 0 0 25px rgba(239, 68, 68, 0.6); transform: scale(1.05); } }

        @keyframes blinkRed { 
            0% { opacity: 1; transform: scale(1); } 
            50% { opacity: 0.4; transform: scale(1.1); box-shadow: 0 0 10px rgba(239, 68, 68, 0.8); } 
            100% { opacity: 1; transform: scale(1); } 
        }
        
        .live-dot { display: inline-block; width: 8px; height: 8px; background-color: var(--danger-color); border-radius: 50%; margin-right: 6px; margin-bottom: 1px; animation: blinkRed 1.2s infinite ease-in-out; }
        .live-tab-dot { display: inline-block; width: 8px; height: 8px; background-color: var(--danger-color); border-radius: 50%; margin-left: 5px; margin-bottom: 1px; box-shadow: 0 0 8px rgba(239, 68, 68, 0.8); animation: blinkRed 1.2s infinite ease-in-out; vertical-align: middle; }
        .live-badge { background: rgba(239, 68, 68, 0.15) !important; border: 1px solid var(--danger-color) !important; color: var(--danger-color) !important; box-shadow: 0 0 10px rgba(239, 68, 68, 0.3) !important; }

        /* AUTHENTICATION */
        #login-section { background-image: radial-gradient(circle at top right, rgba(139, 92, 246, 0.1), transparent 40%), radial-gradient(circle at bottom left, rgba(59, 130, 246, 0.1), transparent 40%); position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 2000; overflow-y: auto; padding: 40px 20px; }
        #login-section.active { display: block !important; }
        .auth-container { max-width: 450px; margin: 0 auto; width: 100%; padding-top: 5vh; }
        .auth-heading { color: var(--text-primary); font-size: 2.2rem; font-weight: 800; margin-bottom: 25px; line-height: 1.2; letter-spacing: 0.5px; }
        
        .auth-input-wrapper { position: relative; margin-bottom: 18px; }
        .auth-input-rounded { background-color: rgba(0,0,0,0.4); border: 1px solid rgba(255, 255, 255, 0.1); color: var(--text-primary); border-radius: 14px; padding: 16px 45px; font-size: 0.95rem; width: 100%; outline: none; transition: 0.3s ease; font-family: inherit; }
        .auth-input-rounded:focus { border-color: var(--accent-color); box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15); background-color: rgba(0,0,0,0.6); }
        .auth-input-rounded::placeholder { color: #64748B; font-weight: 500; }
        
        .auth-icon-left { position: absolute; top: 50%; transform: translateY(-50%); left: 16px; color: #64748B; font-size: 1.1rem; pointer-events: none; }
        .auth-icon-right { position: absolute; top: 50%; transform: translateY(-50%); right: 16px; color: #64748B; font-size: 1.1rem; cursor: pointer; transition: 0.2s; }
        .auth-icon-right:hover { color: var(--accent-color); }
        
        .auth-btn-gradient { background: var(--accent-gradient); color: #FFFFFF; border: none; border-radius: 14px; padding: 16px; font-size: 1rem; font-weight: 700; cursor: pointer; text-transform: uppercase; transition: 0.2s; width: 100%; margin-top: 10px; box-shadow: 0 8px 20px rgba(139, 92, 246, 0.3); display: flex; justify-content: center; align-items: center; gap: 8px; letter-spacing: 1px;}
        .auth-btn-gradient:hover { filter: brightness(1.1); transform: translateY(-2px); box-shadow: 0 12px 25px rgba(139, 92, 246, 0.4);}
        .auth-btn-gradient:active { transform: translateY(0); }
        
        .auth-link-purple { color: var(--accent-color); font-size: 0.85rem; font-weight: 600; text-decoration: none; cursor: pointer; transition: 0.2s; }
        .auth-link-purple:hover { text-decoration: underline; filter: brightness(1.2); }
        
        .auth-footer { text-align: center; margin-top: 25px; color: var(--text-secondary); font-size: 0.9rem; font-weight: 500; }
        .pr-apply { padding-right: 90px; }
        .apply-btn { position: absolute; right: 6px; top: 6px; bottom: 6px; background: rgba(255,255,255,0.1); color: white; border: none; border-radius: 10px; padding: 0 16px; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: 0.2s;}
        .apply-btn:hover { background: rgba(255,255,255,0.2); }
        
        .auth-custom-alert { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 12px; padding: 12px 16px; color: #fff; width: 100%; margin-top: 10px; margin-bottom: 10px; animation: fadeIn 0.3s ease; }
        
        /* HEADER */
        .app-header { position: fixed; top: 0; left: 0; width: 100%; height: 70px; background: rgba(5, 7, 10, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); display: flex; align-items: center; justify-content: space-between; padding: 0 15px; z-index: 1000; border-bottom: 1px solid rgba(255,255,255,0.05); box-shadow: 0 4px 30px rgba(0,0,0,0.5); } 
        .header-left { display: flex; align-items: center; gap: 10px; } 
        .header-logo-container { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(59,130,246,0.2)); border: 1px solid rgba(139,92,246,0.3); border-radius: 10px; font-size: 1.4rem; box-shadow: 0 0 15px rgba(139,92,246,0.2); }
        .header-right { display: flex; align-items: center; gap: 12px; } 
        .wallet-chip { background: linear-gradient(90deg, rgba(16, 185, 129, 0.1), rgba(16, 185, 129, 0.05)); color: var(--success-color); padding: 6px 14px; border-radius: 20px; display: flex; align-items: center; font-size: 0.9rem; font-weight: 700; border: 1px solid rgba(16, 185, 129, 0.2); cursor: pointer; transition: 0.2s; box-shadow: 0 0 10px rgba(16, 185, 129, 0.1); font-family: 'Orbitron', sans-serif;} 
        .wallet-chip:active { transform: scale(0.95); }
        .wallet-chip span { color: #fff; font-weight: 700; margin-left: 6px; font-family: 'Poppins', sans-serif; letter-spacing: 0.5px;}
        .header-avatar-box { width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--border-color); overflow: hidden; padding: 2px; background: var(--secondary-bg); cursor: pointer; transition: 0.3s;}
        .header-avatar-box:hover { border-color: var(--accent-color); box-shadow: 0 0 10px rgba(139, 92, 246, 0.4); }
        .header-avatar-box img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
        .notification-bell { font-size: 1.4rem; color: var(--text-secondary); cursor: pointer; position: relative; transition: 0.2s; }
        .notification-bell:hover { color: var(--text-primary); }
        
        .notification-badge { display: none; position: absolute; top: 0px; right: 0px; width: 10px; height: 10px; background-color: var(--danger-color); border-radius: 50%; border: 2px solid var(--primary-bg); box-shadow: 0 0 8px rgba(239, 68, 68, 0.8); }

        /* BOTTOM NAV */
        .bottom-nav { 
            position: fixed; 
            bottom: 0; 
            left: 0; 
            width: 100%; 
            height: 58px;
            background: #0B0E14; 
            display: flex; 
            justify-content: space-around; 
            align-items: center; 
            z-index: 1000; 
            border-top: 1px solid #1E293B; 
            padding: 0; 
        } 
        .nav-item { 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center; 
            color: #7A849D; 
            text-decoration: none; 
            flex-grow: 1; 
            height: 100%; 
            border: none; 
            background: none; 
            cursor: pointer; 
            position: relative; 
            transition: all 0.2s ease; 
            padding-top: 4px; 
        } 
        .nav-item i { 
            font-size: 1.25rem; 
            line-height: 1;
            margin-bottom: 3px; 
            transition: 0.2s; 
        } 
        .nav-item span { 
            font-size: 0.55rem; 
            font-weight: 700; 
            letter-spacing: 0.5px; 
            font-family: 'Poppins', sans-serif;
            transition: 0.2s;
        } 
        .nav-item.active { 
            color: #3B82F6; 
        } 
        .nav-item.active i, .nav-item.active span {
            color: #3B82F6;
        }
        .nav-dot { 
            width: 4px; 
            height: 4px; 
            background-color: #3B82F6; 
            border-radius: 50%; 
            position: absolute; 
            bottom: 5px; 
            opacity: 0; 
            transition: opacity 0.2s; 
        }
        .nav-item.active .nav-dot { 
            opacity: 1; 
        }
        
        /* HOME & TOURNAMENT CSS */
        .swiper-container#promotionSliderEl { width: 100%; aspect-ratio: 16 / 7.5; height: auto; border-radius: 16px; margin-bottom: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); --swiper-pagination-color: var(--accent-color); --swiper-pagination-bullet-inactive-color: rgba(255,255,255,0.2); --swiper-pagination-bullet-size: 6px; }
        .swiper-slide { background-color: var(--secondary-bg); border-radius: 16px; overflow: hidden; } .swiper-slide img { display: block; width: 100%; height: 100%; object-fit: cover; }
        
        .game-card { text-align: center; background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(0,0,0,0.2)); border-radius: 16px; overflow: hidden; padding: 0; border: 1px solid var(--border-color); cursor: pointer; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); } 
        .game-card:hover { transform: translateY(-5px) scale(1.02); border-color: var(--accent-color); box-shadow: 0 10px 20px rgba(139, 92, 246, 0.2); }
        .game-card img { width: 100%; height: 110px; object-fit: cover; display: block; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .game-card span { display: block; padding: 12px 5px; font-weight: 700; font-size: 0.85rem; color: var(--text-primary); font-family: 'Orbitron', sans-serif; letter-spacing: 0.5px;}
        #gamesListEl.row { --bs-gutter-x: 1rem; --bs-gutter-y: 1rem; }
        
        .tournament-tabs { display: flex; background: rgba(0,0,0,0.3); border-radius: 12px; margin-bottom: 20px; padding: 4px; border: 1px solid var(--border-color); } 
        .tab-item { color: var(--text-secondary); background: transparent; border: none; padding: 10px; font-size: 0.85rem; font-weight: 600; border-radius: 8px; flex-grow: 1; text-align: center; cursor: pointer; transition: 0.3s; } 
        .tab-item.active { color: #fff; background: var(--secondary-bg); box-shadow: 0 4px 10px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05);} 
        
        /* MATCH CARDS */
        .match-card-sc2 { background: var(--secondary-bg); border-radius: 16px; overflow: hidden; border: 1px solid var(--border-color); margin-bottom: 25px; box-shadow: 0 8px 25px rgba(0,0,0,0.4); transition: transform 0.3s; }
        .match-card-sc2:hover { transform: translateY(-3px); border-color: rgba(139, 92, 246, 0.3); box-shadow: 0 12px 30px rgba(139, 92, 246, 0.15); }
        .match-banner-wrapper { position: relative; cursor: pointer; display: block; border-bottom: 2px solid var(--accent-color); }
        .match-banner-sc2 { width: 100%; aspect-ratio: 16/7; object-fit: cover; display: block; opacity: 0.85; transition: 0.3s;}
        .match-banner-wrapper:hover .match-banner-sc2 { opacity: 1; transform: scale(1.02); }
        .match-banner-overlay { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(9,9,11,1) 0%, rgba(9,9,11,0.6) 50%, transparent 100%); padding: 20px 15px 12px 15px; display: flex; justify-content: space-between; align-items: flex-end; }
        .match-title-overlay { color: #fff; font-size: 1.1rem; font-weight: 800; margin: 0; text-shadow: 0 2px 5px rgba(0,0,0,0.9); font-family: 'Orbitron', sans-serif; letter-spacing: 0.5px; }
        .match-badge-overlay { background: rgba(139, 92, 246, 0.2); border: 1px solid var(--accent-color); color: #C4B5FD; padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; box-shadow: 0 0 10px rgba(139, 92, 246, 0.3); letter-spacing: 1px;}
        
        .match-stats-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; padding: 15px; background: rgba(0,0,0,0.2); }
        .match-stat-box { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; padding: 12px 5px; text-align: center; display: flex; flex-direction: column; justify-content: center; transition: 0.2s;}
        .match-stat-box:hover { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); }
        .match-stat-label { font-size: 0.65rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600; margin-bottom: 4px; letter-spacing: 0.5px;}
        .match-stat-value { font-size: 1.2rem; color: #fff; font-weight: 800; font-family: 'Orbitron', sans-serif; }
        .match-stat-value.text-orange { color: #FBBF24; text-shadow: 0 0 10px rgba(245, 158, 11, 0.3); }
        .match-stat-value.text-cyan { color: #38BDF8; text-shadow: 0 0 10px rgba(56, 189, 248, 0.3); }
        
        .match-progress-container { padding: 0 15px 15px 15px; }
        .match-progress-header { display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 8px; font-weight: 600; }
        .match-progress-header .slots { color: var(--text-secondary); }
        .match-progress-header .left { color: var(--warning-color); }
        .match-progress-bar-bg { background-color: rgba(255,255,255,0.05); height: 8px; border-radius: 4px; width: 100%; overflow: hidden; border: 1px solid rgba(255,255,255,0.05); }
        .match-progress-bar-fill { background: linear-gradient(90deg, #F59E0B, #EF4444); height: 100%; border-radius: 4px; box-shadow: 0 0 10px rgba(245, 158, 11, 0.5); }
        
        .match-footer-sc2 { display: flex; justify-content: space-between; align-items: center; padding: 0 15px 15px 15px; font-size: 0.8rem; color: var(--text-secondary); font-weight: 500;}
        .match-footer-sc2 i { margin-right: 5px; color: var(--accent-color); }

        .btn-idpass { background: rgba(245, 158, 11, 0.15); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.3); font-weight: 700; transition: 0.2s;}
        .btn-idpass:hover { background: rgba(245, 158, 11, 0.25); box-shadow: 0 0 15px rgba(245, 158, 11, 0.2); }
        .btn-chat { background: rgba(56, 189, 248, 0.15); color: #38BDF8; border: 1px solid rgba(56, 189, 248, 0.3); font-weight: 700; transition: 0.2s;}
        .btn-chat:hover { background: rgba(56, 189, 248, 0.25); box-shadow: 0 0 15px rgba(56, 189, 248, 0.2); }

        /* PROFILE SECTION */
        .stat-card { background: linear-gradient(180deg, var(--card-bg), rgba(0,0,0,0.2)); border-radius: 16px; padding: 20px 15px; border: 1px solid var(--border-color); display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; box-shadow: 0 5px 15px rgba(0,0,0,0.2); }
        .stat-icon-box { width: 45px; height: 45px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; margin-bottom: 12px;}
