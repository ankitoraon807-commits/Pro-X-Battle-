                let hasLive = false;
                
                if(s.exists()) {
                    let found = false;
                    Object.entries(s.val()).forEach(([tId, t]) => {
                        if(t.status === 'ongoing') hasLive = true;
                        
                        if(t.status === status) {
                            found = true;
                            const card = createTournamentCardElement(tId, t);
                            elements.tournamentsListContainer.appendChild(card);
                        }
                    });
                    if(!found) elements.tournamentsListContainer.innerHTML = `<p class="text-center text-secondary mt-5 fw-medium">No matches found.</p>`;
                } else { 
                    elements.tournamentsListContainer.innerHTML = `<p class="text-center text-secondary mt-5 fw-medium">No matches found.</p>`; 
                }
                
                const liveTabDot = document.querySelector('.live-tab-dot');
