        window.viewMatchResults = async function(tId) {
            const tbody = document.getElementById('matchResultsTableBodyEl');
            tbody.innerHTML = '<tr><td colspan="4" class="text-center p-4"><div class="spinner-border text-warning"></div></td></tr>';
            const resModal = new bootstrap.Modal(document.getElementById('matchResultsModalEl'));
            resModal.show();
            
            try {
                const [resSnap, regSnap] = await Promise.all([
                    get(ref(db, `tournaments/${tId}/results`)),
                    get(ref(db, `tournaments/${tId}/registeredPlayers`))
                ]);

                if (resSnap.exists()) {
                    const resultsObj = resSnap.val();
                    const regPlayers = regSnap.exists() ? regSnap.val() : {};

                    const results = Object.keys(resultsObj).map(key => {
                        return { _key: key, ...resultsObj[key] };
                    });

                    results.sort((a, b) => (a.rank || 999) - (b.rank || 999));
                    
                    let html = '';
                    results.forEach(r => {
                        let rankDisplay = r.rank;
                        if(r.rank === 1) rankDisplay = '<span style="color:#FBBF24; font-size:1.2rem;">🥇 1st</span>';
                        else if(r.rank === 2) rankDisplay = '<span style="color:#CBD5E1; font-size:1.1rem;">🥈 2nd</span>';
                        else if(r.rank === 3) rankDisplay = '<span style="color:#D97706; font-size:1rem;">🥉 3rd</span>';
                        else rankDisplay = `#${r.rank}`; 
                        
                        let uid = r.uid || r._key;
                        let participant = regPlayers[uid] || {};
                        let pName = participant.username || r.username || r.gameName || r.displayName || 'Player';
                        
                        html += `
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td class="fw-bold align-middle font-orbitron">${rankDisplay}</td>
                            <td class="text-start align-middle">
                                <div class="fw-bold text-white mb-1" style="font-size: 0.95rem; letter-spacing:0.5px;"> ${sanitizeHTML(pName)}</div>
                            </td>
                            <td class="align-middle fw-bold text-info">${r.kills || 0}</td>
                            <td class="text-success fw-bold align-middle font-orbitron" style="font-size:1.1rem;">₹${r.prize || 0}</td>
                        </tr>`;
                    });
                    tbody.innerHTML = html;
                } else {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center p-5 text-secondary fw-medium">Results not published yet.</td></tr>';
                }
            } catch (err) { tbody.innerHTML = '<tr><td colspan="4" class="text-center p-5 text-danger">Failed to load results.</td></tr>'; }
        };

