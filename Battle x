                        if((t.status === 'completed' || t.status === 'result') && t.registeredPlayers) {
                            let isParticipant = false;
                            for (let k in t.registeredPlayers) {
                                if (k === currentUser.uid || t.registeredPlayers[k].uid === currentUser.uid) {
                                    isParticipant = true; break;
                                }
                            }
                            if (isParticipant) {
                                found = true;
                                tournaments.push({id: tId, ...t});
                            }
                        }
                    });
                    
                    if (found) {
                        tournaments.reverse().forEach(t => {
                            elements.resultsListContainerEl.appendChild(createTournamentCardElement(t.id, t));
                        });
                    } else {
                        elements.resultsListContainerEl.innerHTML = `<p class="text-center text-secondary mt-5 fw-medium">You haven't played any completed matches yet.</p>`;
                    }
                } else {
                    elements.resultsListContainerEl.innerHTML = `<p class="text-center text-secondary mt-5 fw-medium">No matches found.</p>`;
                }
            }).catch(err => {
                elements.resultsListContainerEl.innerHTML = `<p class="text-center text-secondary mt-5 fw-medium">Error loading results.</p>`;
            });
        }

