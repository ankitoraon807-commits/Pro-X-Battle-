                                statusIcon = '<i class="bi bi-x-circle-fill" style="color: var(--danger-color);"></i>';
                                statusColor = 'var(--danger-color)';
                            }
                            
                            let amountText = isCr ? `+₹${Math.abs(amt).toFixed(2)}` : `-₹${Math.abs(amt).toFixed(2)}`;
                            let amountColor = isCr ? 'var(--success-color)' : 'var(--text-primary)';

