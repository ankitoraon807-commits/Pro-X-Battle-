        async function submitWithdrawRequestHandler() { 
            const amt = parseFloat(elements.withdrawAmountInput.value); 
            const mtd = elements.withdrawMethodInput.value.trim(); 
            const minW = appSettings.minWithdraw !== undefined ? appSettings.minWithdraw : 50;
            const withdrawFee = 5; 

            if(amt >= minW && amt <= (userProfile.winningCash||0) && mtd) {
                const finalAmtToPay = amt - withdrawFee;
                if(finalAmtToPay <= 0) {
                    window.showCustomAlert(`Amount after ₹${withdrawFee} fee must be greater than 0.`);
                    return;
                }

                elements.submitWithdrawRequestBtn.disabled = true;
                try {
                    const userRef = ref(db, `users/${currentUser.uid}`);
                    const snap = await get(userRef);
                    if(snap.exists()) {
                        let prof = snap.val();
                        if (prof.winningCash >= amt) {
                            
                            const newWdRef = push(ref(db, 'withdrawals'));
                            const newTxRef = push(ref(db, `transactions/${currentUser.uid}`));
                            const feeTxRef = push(ref(db, `transactions/${currentUser.uid}`));
                            
                            const updates = {};
                            updates[`users/${currentUser.uid}/winningCash`] = prof.winningCash - amt;
                            updates[`users/${currentUser.uid}/balance`] = prof.balance - amt;
                            
                            updates[`withdrawals/${newWdRef.key}`] = { 
                                userId: currentUser.uid, 
                                amount: finalAmtToPay, 
                                requestedAmount: amt,  
                                fee: withdrawFee,
                                methodDetails: { methodName: 'UPI', accountInfo: mtd }, 
                                status: 'pending', 
                                requestTimestamp: serverTimestamp(),
                                txId: newTxRef.key
                            };
                            
                            updates[`transactions/${currentUser.uid}/${newTxRef.key}`] = {
                                type: 'withdraw_request',
                                amount: -finalAmtToPay,
                                description: 'Withdrawal to UPI',
                                timestamp: serverTimestamp(),
                                status: 'pending',
                                withdrawalId: newWdRef.key
                            };
                            
                            updates[`transactions/${currentUser.uid}/${feeTxRef.key}`] = {
                                type: 'withdrawal_fee',
                                amount: -withdrawFee,
                                description: 'Withdrawal Processing Fee',
                                timestamp: serverTimestamp(),
                                status: 'completed'
                            };

                            await update(ref(db), updates);
                            
                            document.getElementById('wsModalRequested').textContent = `₹${amt.toFixed(2)}`;
                            document.getElementById('wsModalFee').textContent = `₹${withdrawFee.toFixed(2)}`;
                            document.getElementById('wsModalReceive').textContent = `₹${finalAmtToPay.toFixed(2)}`;
                            
                            elements.withdrawalSuccessModalInstance.show();

                            window.AndroidNotif.show({
                                appName: "PRO X WALLET",
                                title: "Withdrawal Requested 💸",
                                message: `Withdrawal request of ₹${amt} has been submitted successfully.`,
                                iconClass: "bi-wallet2",
                                onClick: () => showSection('wallet-section')
                            });
                            
                            document.getElementById('wsGoToWalletBtn').onclick = () => {
                                elements.withdrawalSuccessModalInstance.hide();
                                showSection('wallet-section');
                                loadRecentTransactions();
                            };
                        }
                    }
                } catch(e) { window.showCustomAlert("Error: " + e.message); } 
                finally { elements.submitWithdrawRequestBtn.disabled = false; }
            } else {
                window.showCustomAlert(`Minimum withdraw is ₹${minW} or insufficient winning balance.`);
            }
        }

        function initializeEventListeners() {
             NavManager.init();

             ZapUPI.setPaymentCallbacks({
               onSuccess: async function(orderId) {
                 if (currentUser) {
                     showLoader(true);
                     try {
                         const amountToAdd = parseFloat(currentRechargeData.amount);
                         const userRef = ref(db, `users/${currentUser.uid}`);
                         const snap = await get(userRef);
                         if(snap.exists()) {
                             let currentBal = parseFloat(snap.val().balance) || 0;
                             let newTotal = currentBal + amountToAdd;
                             
                             await set(ref(db, `users/${currentUser.uid}/balance`), newTotal);
                             try { await recordTransaction(currentUser.uid, 'deposit_success', amountToAdd, `Deposit`, { orderId: orderId }); } catch(trxErr) {}
                             
                             await processFirstDepositBonus(currentUser.uid);
                             
                             let newWinning = parseFloat(snap.val().winningCash) || 0;
                             let newBonus = parseFloat(snap.val().bonusCash) || 0;
                             let newDeposit = newTotal - newWinning - newBonus;
                             if(newDeposit < 0) newDeposit = 0;

                             document.getElementById('psModalTotal').textContent = `₹${newTotal.toFixed(2)}`;
                             document.getElementById('psModalDeposit').textContent = `₹${Math.floor(newDeposit)}`;
                             document.getElementById('psModalWinnings').textContent = `₹${Math.floor(newWinning)}`;
                             document.getElementById('psModalBonus').textContent = `₹${Math.floor(newBonus)}`;
                             
                             elements.paymentSuccessUiModalInstance.show(); 
                             showSection('wallet-section');

                             window.AndroidNotif.show({
                                 appName: "PRO X WALLET",
                                 title: "Payment Successful! 🎉",
                                 message: `₹${amountToAdd} has been successfully added to your wallet.`,
                                 iconClass: "bi-shield-check",
                                 onClick: () => showSection('wallet-section')
                             });
                         }
                     } catch (e) { window.showCustomAlert("Error adding balance: " + e.message); } 
                     showLoader(false);
                 }
               },
               onFailed: function() { window.showCustomAlert("Payment Failed"); showSection('wallet-section'); },
               onTimeout: function() { window.showCustomAlert("Payment Timed Out"); showSection('wallet-section'); }
             });

             elements.bottomNavItems?.forEach(item => item.addEventListener('click', (e) => { e.preventDefault(); showSection(item.dataset.section); }));
             
             getElement('headerAvatarBtn')?.addEventListener('click', () => showSection('profile-section'));
             
             elements.profileImageUpload?.addEventListener('change', async (e) => {
                 const file = e.target.files[0];
                 if (!file) return;
                 
                 if (!file.type.startsWith('image/')) {
                     window.showCustomAlert('Please select a valid image file.');
                     return;
                 }

                 showLoader(true);
                 
                 const reader = new FileReader();
                 reader.onload = function(event) {
                     const img = new Image();
                     img.onload = async function() {
                         const canvas = document.createElement('canvas');
                         const MAX_WIDTH = 256; const MAX_HEIGHT = 256;
                         let width = img.width; let height = img.height;

                         if (width > height) {
                             if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; }
                         } else {
                             if (height > MAX_HEIGHT) { width *= MAX_HEIGHT / height; height = MAX_HEIGHT; }
                         }
                         
                         canvas.width = width; canvas.height = height;
                         const ctx = canvas.getContext('2d');
                         ctx.drawImage(img, 0, 0, width, height);
                         
                         const dataUrl = canvas.toDataURL('image/jpeg', 0.8);
                         
                         if(elements.profileAvatar) elements.profileAvatar.src = dataUrl;
                         const mainAvatar = document.getElementById('mainProfileAvatarEl');
                         if(mainAvatar) mainAvatar.src = dataUrl;

                         if (currentUser) {
                             try {
                                 await update(ref(db, `users/${currentUser.uid}`), { photoURL: dataUrl });
                                 window.showCustomAlert('Profile photo updated successfully!');
                             } catch (err) { window.showCustomAlert('Error saving image to server.'); }
                         }
                         showLoader(false); e.target.value = '';
                     };
                     img.src = event.target.result;
                 };
                 reader.readAsDataURL(file);
             });
             
             getElement('editProfileSettingsBtn')?.addEventListener('click', () => {
                 elements.editNameInput.value = userProfile.displayName || '';
                 const editPhone = getElement('editPhoneInput');
                 if(editPhone) editPhone.value = userProfile.phoneNumber || '';
                 const editEmail = getElement('editEmailInput');
                 if(editEmail) editEmail.value = userProfile.email || currentUser.email || '';
                 const editRef = getElement('editReferralCodeInput');
                 if(editRef) editRef.value = userProfile.referralCode || '';
                 
                 elements.editNameModalInstance.show();
             });
             
             elements.saveNameChangeBtn?.addEventListener('click', async () => {
                 const newName = elements.editNameInput.value.trim();
                 const newPhone = getElement('editPhoneInput').value.trim();
                 
                 if(newName && currentUser) {
                     elements.saveNameChangeBtn.disabled = true;
                     try {
                         await update(ref(db, `users/${currentUser.uid}`), { 
                             displayName: newName,
                             phoneNumber: newPhone 
                         });
                         userProfile.displayName = newName;
                         userProfile.phoneNumber = newPhone;
                         populateUserInfo(currentUser, userProfile);
                         elements.editNameModalInstance.hide();
                         window.showCustomAlert('Profile updated successfully!');
                     } catch (error) {
                         window.showCustomAlert('Error updating profile: ' + error.message);
                     } finally {
                         elements.saveNameChangeBtn.disabled = false;
                     }
                 } else {
                     window.showCustomAlert('Name cannot be empty.');
                 }
             });

             elements.loginEmailForm = getElement('emailLoginForm');
             elements.loginEmailForm?.addEventListener('submit', (e) => { e.preventDefault(); loginWithEmail(); });
             
             elements.signupEmailForm = getElement('emailSignupForm');
             elements.signupEmailForm?.addEventListener('submit', (e) => { e.preventDefault(); signUpWithEmail(); });
             
             elements.logoutProfileBtn?.addEventListener('click', logoutUser);
             
             elements.showSignupToggleBtn?.addEventListener('click', () => toggleAuthForm('signup'));
             elements.showLoginToggleBtn?.addEventListener('click', () => toggleAuthForm('login'));

             elements.tournamentTabs?.forEach(tab => {
                 tab.addEventListener('click', (e) => {
                     elements.tournamentTabs.forEach(t => t.classList.remove('active'));
                     e.target.classList.add('active');
                     if(currentTournamentGameId) filterTournaments(currentTournamentGameId, e.target.dataset.status);
                 });
             });

             const trxTabs = querySelAll('.trx-tab');
             trxTabs.forEach(tab => {
                 tab.addEventListener('click', (e) => {
                     trxTabs.forEach(t => { 
                         t.classList.remove('active'); 
                         t.classList.add('text-secondary'); 
                         t.style.background = 'transparent'; 
                     });
                     e.target.classList.add('active'); 
                     e.target.classList.remove('text-secondary');
                     e.target.style.background = 'rgba(255,255,255,0.1)';
                     currentTrxFilter = e.target.dataset.filter;
                     loadRecentTransactions();
                 });
             });

             elements.policyLinks?.forEach(link => link.addEventListener('click', handlePolicyClick));
             elements.submitWithdrawRequestBtn?.addEventListener('click', submitWithdrawRequestHandler);
             
             getElement('fabTelegramBtn')?.addEventListener('click', (e) => {
                 e.preventDefault();
                 window.open(`https://t.me/proxbattle`, '_blank');
             });

             getElement('fabWhatsappBtn')?.addEventListener('click', (e) => {
                 e.preventDefault();
                 window.open(`https://whatsapp.com/channel/0029VbE72NnCRs1tqLWex02N`, '_blank');
             });

             getElement('liveSupportBtnEl')?.addEventListener('click', openLiveSupport);
             getElement('adminPanelBtnEl')?.addEventListener('click', openAdminDashboard);
             elements.supportChatForm?.addEventListener('submit', submitSupportMessage);
             elements.adminChatForm?.addEventListener('submit', submitAdminMessage);
        }

        document.addEventListener('DOMContentLoaded', () => {
             setTimeout(() => {
                 const splash = getElement('splash-screen');
                 if(splash) {
                     splash.classList.add('hidden');
                     setTimeout(() => splash.style.display = 'none', 500);
                 }
             }, 2000);

             setupSettingsListener();
             initializeEventListeners();
             
             if (auth) {
                 onAuthStateChanged(auth, handleAuthStateChange);
             } else {
                 showSection('login-section');
             }
        });
    </script>
