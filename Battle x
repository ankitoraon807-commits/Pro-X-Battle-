            if (!currentUser) return;
            try {
                const badge = document.getElementById('notifBadgeEl');
                if(!badge) return;
                
                let latestTime = 0;
                
                try {
                    const globalQuery = query(ref(db, 'notifications'), orderByChild('timestamp'), limitToLast(1));
