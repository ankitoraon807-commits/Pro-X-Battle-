                    if(currentTrxFilter === 'deposit') {
                        transactions = transactions.filter(t => {
                            let amt = parseFloat(t.amount || 0); let type = (t.type || '').toLowerCase();
                            return amt > 0 || type.includes('deposit') || type.includes('win') || type.includes('bonus');
                        });
                    } else if(currentTrxFilter === 'withdraw') {
                        transactions = transactions.filter(t => {
                            let amt = parseFloat(t.amount || 0); let type = (t.type || '').toLowerCase();
                            return amt < 0 || type.includes('withdraw') || type.includes('join') || type.includes('fee');
                        });
