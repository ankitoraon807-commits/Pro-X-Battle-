        window.confirmAndJoinTournament = async function() {
            const { tId, fee, mode } = currentJoinTournamentData;
            let inputsValid = true;
            let slotsToRegister = [];
            
            if (currentSelectedPositions.length > 0) {
                currentSelectedPositions.forEach((pos, idx) => {
                    const uname = document.getElementById(`joinUsername_${idx}`).value.trim();
                    const uid = document.getElementById(`joinGameUid_${idx}`).value.trim();
                    if (!uname || !uid) inputsValid = false;
                    slotsToRegister.push({ ...pos, username: uname, gameUid: uid });
                });
            } else {
                const uname = document.getElementById(`joinUsername_0`).value.trim();
                const uid = document.getElementById(`joinGameUid_0`).value.trim();
                if (!uname || !uid) inputsValid = false;
                slotsToRegister.push({ username: uname, gameUid: uid });
            }
            
            if (!inputsValid) { 
                showStatusMessage(elements.joinTournamentStatusMessage, 'In-Game Name and UID are required for all slots.', 'warning'); 
                return; 
            }
            
            const totalFee = fee * slotsToRegister.length;
            elements.confirmJoinBtn.disabled = true;
            elements.confirmJoinBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';
            
            try {
                const [userSnap, tourneySnap] = await Promise.all([
                    get(ref(db, `users/${currentUser.uid}`)),
                    get(ref(db, `tournaments/${tId}`))
                ]);

                if (!userSnap.exists()) throw new Error("User profile not found.");
                if (!tourneySnap.exists()) throw new Error("Tournament not found.");

                const prof = userSnap.val();
                const tourney = tourneySnap.val();

                if (tourney.status !== 'upcoming') {
                    throw new Error("This match is no longer accepting entries (Already started or closed).");
                }
                if (prof.joinedTournaments && prof.joinedTournaments[tId]) {
                    throw new Error("You are already registered for this match.");
                }

                const registeredPlayers = tourney.registeredPlayers || {};
                const currentPlayersCount = Object.keys(registeredPlayers).length;
                const maxPlayers = tourney.maxPlayers || 0;

                if (maxPlayers > 0 && (currentPlayersCount + slotsToRegister.length) > maxPlayers) {
                    throw new Error(`Match doesn't have enough slots! Only ${maxPlayers - currentPlayersCount} left.`);
                }

                if (['DUO', 'SQUAD'].some(m => mode.includes(m))) {
                    if (slotsToRegister.length === 0) {
                        throw new Error("Please select valid slots for the match.");
                    }
                    for (let p in registeredPlayers) {
                        for(let s of slotsToRegister) {
                            if (registeredPlayers[p].teamSlot === s.team &&
                                registeredPlayers[p].playerSlot === s.player) {
                                throw new Error(`Team ${s.team} - Slot ${s.player} was just taken by someone else! Please select another slot.`);
                            }
                        }
                    }
                }

                let currentBonus = parseFloat(prof.bonusCash) || 0;
                let currentWinning = parseFloat(prof.winningCash) || 0;
                let currentTotal = parseFloat(prof.balance) || 0;
                let currentDeposit = currentTotal - currentBonus - currentWinning;
                if (currentDeposit < 0) currentDeposit = 0;

                let maxBonusUsable = totalFee * 0.10;
                let usableBonus = Math.min(currentBonus, maxBonusUsable);
                let usableTotalBalance = currentDeposit + currentWinning + usableBonus;

                if (usableTotalBalance < totalFee) { 
                    throw new Error("INSUFFICIENT_BALANCE"); 
                }
                
                let remainingFee = totalFee;
                let bonusToDeduct = Math.min(remainingFee, usableBonus);
                currentBonus -= bonusToDeduct;
                remainingFee -= bonusToDeduct;
                
                if (remainingFee > 0) {
                    if (currentDeposit >= remainingFee) { 
                        currentDeposit -= remainingFee; 
                        remainingFee = 0; 
                    } else { 
                        remainingFee -= currentDeposit; 
                        currentDeposit = 0; 
                    }
                }
                
                if (remainingFee > 0) { 
                    currentWinning -= remainingFee; 
                }
                
                let newBalance = currentDeposit + currentWinning + currentBonus;
                const newTxKey = push(ref(db, `transactions/${currentUser.uid}`)).key;

                const updates = {};
                updates[`users/${currentUser.uid}/balance`] = newBalance;
                updates[`users/${currentUser.uid}/bonusCash`] = currentBonus;
                updates[`users/${currentUser.uid}/winningCash`] = currentWinning;
                
                updates[`users/${currentUser.uid}/defaultGameName`] = slotsToRegister[0].username;
                updates[`users/${currentUser.uid}/defaultGameUid`] = slotsToRegister[0].gameUid;
                updates[`users/${currentUser.uid}/joinedTournaments/${tId}`] = true;
                
                slotsToRegister.forEach((slot, index) => {
                    let playerRegData = {
                        joinedAt: serverTimestamp(),
                        username: slot.username,
                        gameUid: slot.gameUid,
                        uid: currentUser.uid
                    };
                    
                    if (slot.team && slot.player) {
                        playerRegData.teamSlot = slot.team;
                        playerRegData.playerSlot = slot.player;
                    }
                    
                    let slotKey = index === 0 ? currentUser.uid : push(ref(db, `tournaments/${tId}/registeredPlayers`)).key;
                    updates[`tournaments/${tId}/registeredPlayers/${slotKey}`] = playerRegData;
                });
                
                updates[`transactions/${currentUser.uid}/${newTxKey}`] = {
                    type: 'tournament_join',
                    amount: -totalFee,
                    description: `Entry Fee (${slotsToRegister.length} Slot${slotsToRegister.length>1?'s':''})`, 
                    timestamp: serverTimestamp(),
                    tournamentId: tId
                };

                await update(ref(db), updates);
                
                if(!userProfile.joinedTournaments) userProfile.joinedTournaments = {};
                userProfile.joinedTournaments[tId] = true;
                populateUserInfo(currentUser, { 
                    ...prof, 
                    balance: newBalance, 
                    bonusCash: currentBonus, 
                    winningCash: currentWinning, 
                    joinedTournaments: userProfile.joinedTournaments 
                });

                elements.joinTournamentDetailsModalInstance.hide();
                elements.matchJoinedSuccessModalInstance.show();
                elements.goToMyMatchesBtn.onclick = () => {
                    elements.matchJoinedSuccessModalInstance.hide();
                    showSection('my-contests-section');
                };

                window.AndroidNotif.show({
                    appName: "PRO X BATTLE",
                    title: "Match Joined! 🎮",
                    message: "Slot confirmed. ID/Pass will be shared before match starts.",
                    iconClass: "bi-check2-circle",
                    onClick: () => showSection('my-contests-section')
                });
                
                if (currentTournamentGameId) {
                    const activeTab = querySel('.tournament-tabs .tab-item.active')?.dataset.status || 'upcoming';
                    filterTournaments(currentTournamentGameId, activeTab);
                }
                loadMyContests(); 
                
            } catch (e) { 
                if(e.message === "INSUFFICIENT_BALANCE") {
                    elements.joinTournamentDetailsModalInstance.hide();
                    if(!elements.insufficientBalanceModalInstance) { 
                        elements.insufficientBalanceModalInstance = new bootstrap.Modal(getElement('insufficientBalanceModal')); 
                    }
                    const msgEl = getElement('insufficientBalanceMessageEl');
                    if(msgEl) msgEl.textContent = `Insufficient balance. Required: ₹${totalFee}. Please add money to your wallet.`;
                    elements.insufficientBalanceModalInstance.show();
                } else { 
                    showStatusMessage(elements.joinTournamentStatusMessage, e.message, 'danger'); 
                }
            } 
            finally { 
                elements.confirmJoinBtn.disabled = false; 
                elements.confirmJoinBtn.innerHTML = "JOIN & PAY"; 
            }
        };

