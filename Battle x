                        elements.noLeaderboardMessageEl.style.display = 'block';
                    }
                } else {
                    elements.leaderboardListEl.style.display = 'none';
                    elements.noLeaderboardMessageEl.style.display = 'block';
                }
            } catch(e) {
                elements.leaderboardListEl.innerHTML = '';
                elements.noLeaderboardMessageEl.style.display = 'block';
            }
        }

        async function recordTransaction(userId, type, amount, description, details = {}) { 
            if (!userId) return; 
            await push(ref(db, `transactions/${userId}`), { type, amount: Number(amount), description, timestamp: serverTimestamp(), ...details }); 
        }

        function setupRealtimeListeners(uid) { 
            detachAllDbListeners(); 
            
            const uRef = ref(db, `users/${uid}`); 
            const unsubProfile = onValue(uRef, (s) => { 
                if (s.exists()) { userProfile = s.val(); populateUserInfo(currentUser, userProfile); } 
            }); 
            dbListeners['userProfile'] = () => off(uRef, 'value', unsubProfile); 
            
            const now = Date.now();
            const globalNotifRef = query(ref(db, 'notifications'), orderByChild('timestamp'), startAt(now));
            const unsubGlobalNotif = onChildAdded(globalNotifRef, (snap) => {
                const notif = snap.val();
                if(notif && typeof notif === 'object') {
                    const badge = document.getElementById('notifBadgeEl');
                    if (badge && currentSectionId !== 'notifications-section') badge.style.display = 'block';
                    
                    window.AndroidNotif.show({
                        appName: "PRO X BATTLE",
                        title: notif.title || "New Notification",
                        message: notif.message || notif.body || "",
                        iconClass: "bi-bell-fill",
                        onClick: () => showSection('notifications-section')
                    });
                }
            });
            dbListeners['globalNotifs'] = () => off(globalNotifRef, 'child_added', unsubGlobalNotif);
            
            const userNotifRef = query(ref(db, `users/${uid}/notifications`), orderByChild('timestamp'), startAt(now));
            const unsubUserNotif = onChildAdded(userNotifRef, (snap) => {
                const notif = snap.val();
                if(notif && typeof notif === 'object') {
                    const badge = document.getElementById('notifBadgeEl');
                    if (badge && currentSectionId !== 'notifications-section') badge.style.display = 'block';
                    
                    window.AndroidNotif.show({
                        appName: "PRO X BATTLE",
                        title: notif.title || "New Alert",
                        message: notif.message || notif.body || "",
                        iconClass: "bi-bell-fill",
                        onClick: () => showSection('notifications-section')
                    });
                }
            });
            dbListeners['userNotifs'] = () => off(userNotifRef, 'child_added', unsubUserNotif);

            const userSupportRef = ref(db, `support_chats/${uid}`);
            const unsubSupport = onValue(userSupportRef, (snap) => {
                if(snap.exists()) {
                    const hasUnread = snap.val().hasUnreadUser;
                    const badge = document.getElementById('supportUnreadBadge');
                    if(badge) badge.style.display = hasUnread ? 'inline-block' : 'none';
                    if(hasUnread) {
                        window.AndroidNotif.show({
                            appName: "PRO X SUPPORT",
                            title: "Support Reply",
                            message: "Admin has replied to your support message.",
                            iconClass: "bi-headset",
                            onClick: () => openLiveSupport()
                        });
                    }
                }
            });
            dbListeners['userSupport'] = () => off(userSupportRef, 'value', unsubSupport);

            if(userProfile.isAdmin) {
                const allSupportRef = ref(db, 'support_chats');
                const unsubAllSupport = onValue(allSupportRef, (snap) => {
                    let hasAnyUnread = false;
                    if(snap.exists()) {
                        snap.forEach(c => { if(c.val().hasUnreadAdmin) hasAnyUnread = true; });
                    }
                    const aBadge = document.getElementById('adminGlobalUnreadBadge');
                    if(aBadge) aBadge.style.display = hasAnyUnread ? 'inline-block' : 'none';
                });
                dbListeners['adminSupport'] = () => off(allSupportRef, 'value', unsubAllSupport);
            }
            
            const lbModeRef = ref(db, 'settings/leaderboardMode');
            const unsubLbMode = onValue(lbModeRef, () => {
                if(currentSectionId === 'leaderboard-section') {
                    loadLeaderboardData();
                }
            });
            dbListeners['leaderboardMode'] = () => off(lbModeRef, 'value', unsubLbMode);
        }

        function detachAllDbListeners() { 
            for (const k in dbListeners) {
                if (typeof dbListeners[k] === 'function') {
                    dbListeners[k](); 
                }
            } 
            dbListeners = {}; 
        }

