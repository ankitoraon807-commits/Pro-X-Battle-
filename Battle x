        class AndroidNotificationManager {
            constructor() {
                this.container = document.getElementById('androidNotificationContainer');
                this.queue = [];
                this.isDisplaying = false;
            }

            show({ title, message, appName = "Pro X Battle", iconClass = "bi-controller", duration = 4000, onClick = null }) {
                const timeString = new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                this.queue.push({ title, message, appName, iconClass, time: timeString, duration, onClick });
                this.processQueue();
            }

            processQueue() {
                if (this.isDisplaying || this.queue.length === 0) return;
                this.isDisplaying = true;
                const data = this.queue.shift();

                if ("vibrate" in navigator) {
                    try { navigator.vibrate([50, 50, 50]); } catch(e){}
                }

                this.playNotifSound();

                const card = document.createElement('div');
                card.className = 'android-notif-card';
                card.innerHTML = `
                    <div class="android-notif-header">
                        <div class="android-notif-app-info">
                            <div class="android-notif-icon"><i class="bi ${data.iconClass}"></i></div>
                            <span class="android-notif-app-name">${data.appName}</span>
                        </div>
                        <span class="android-notif-time">${data.time}</span>
                    </div>
                    <div class="android-notif-body">
                        <div class="android-notif-title">${data.title}</div>
                        <div class="android-notif-message">${data.message}</div>
                    </div>
                `;

                if (typeof data.onClick === 'function') {
                    card.addEventListener('click', (e) => {
                        data.onClick(e);
                        this.dismissCard(card);
                    });
                }

                let startY = 0;
                card.addEventListener('touchstart', (e) => { startY = e.touches[0].clientY; });
                card.addEventListener('touchmove', (e) => {
                    let diff = e.touches[0].clientY - startY;
                    if (diff < -15) { this.dismissCard(card); }
                });

                this.container.appendChild(card);
                setTimeout(() => card.classList.add('show'), 20);

                const dismissTimer = setTimeout(() => {
                    this.dismissCard(card);
                }, data.duration);

                card.addEventListener('click', () => {
                    clearTimeout(dismissTimer);
                }, { once: true });
            }

            dismissCard(card) {
                if (!card.classList.contains('show')) return;
                card.classList.remove('show');
                card.classList.add('hide');
                setTimeout(() => {
                    card.remove();
                    this.isDisplaying = false;
                    this.processQueue();
                }, 300);
            }

            playNotifSound() {
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                    osc.frequency.setValueAtTime(880, ctx.currentTime + 0.08); 
                    gain.gain.setValueAtTime(0.12, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.3);
                } catch(e) {}
            }
        }

