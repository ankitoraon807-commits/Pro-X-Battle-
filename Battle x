        function buildPositionGridHTML(mode, maxPlayers, occupiedSlots) {
            let playersPerTeam = mode.includes('SQUAD') ? 4 : (mode.includes('DUO') ? 2 : 1);
            if (playersPerTeam === 1) return ''; 

            let totalTeams = Math.ceil(maxPlayers / playersPerTeam) || (playersPerTeam === 4 ? 12 : 24);
            let cols = playersPerTeam === 4 ? ['A', 'B', 'C', 'D'] : ['A', 'B'];
            
            let html = '<div class="table-responsive"><table class="pos-table"><thead><tr><th>TEAM</th>';
            cols.forEach(c => html += `<th>P${c}</th>`);
            html += '</tr></thead><tbody>';
            
            for (let i = 1; i <= totalTeams; i++) {
                html += `<tr><td>Team ${i}</td>`;
                cols.forEach((c, idx) => {
                    let slotKey = `${i}-${c}`;
                    let isOccupied = occupiedSlots.has(slotKey);
                    let num = idx + 1;
                    
                    if (isOccupied) {
                        html += `<td>
                            <div class="pos-checkbox-wrapper disabled">
                                <span class="pos-number">${num}</span>
                                <div class="pos-checkbox-box taken">✓</div>
                            </div>
                        </td>`;
                    } else {
                        html += `<td>
                            <div class="pos-checkbox-wrapper" onclick="selectPosition(${i}, '${c}')">
                                <span class="pos-number">${num}</span>
                                <div class="pos-checkbox-box available" id="pos-box-${i}-${c}"></div>
                            </div>
                        </td>`;
                    }
                });
                html += '</tr>';
            }
            html += '</tbody></table></div>';
            return html;
        }

        window.selectPosition = function(team, player) {
            let box = document.getElementById(`pos-box-${team}-${player}`);
            let idx = currentSelectedPositions.findIndex(p => p.team === team && p.player === player);
            
            if (idx !== -1) {
                currentSelectedPositions.splice(idx, 1);
                if (box) box.classList.remove('selected');
            } else {
                currentSelectedPositions.push({ team, player });
                if (box) box.classList.add('selected');
            }
            
            const btn = document.getElementById('confirmPositionBtn');
            if (currentSelectedPositions.length > 0) {
                btn.disabled = false;
                btn.innerHTML = `PROCEED (${currentSelectedPositions.length} SLOTS) <i class="bi bi-arrow-right fw-bold ms-1"></i>`;
            } else {
                btn.disabled = true;
                btn.innerHTML = `PROCEED <i class="bi bi-arrow-right fw-bold ms-1"></i>`;
            }
        };

        window.openPositionSelectionModal = async function(tId, mode, maxPlayers) {
            showLoader(true);
            try {
                const snap = await get(ref(db, `tournaments/${tId}/registeredPlayers`));
                const occupiedSlots = new Set();
                
                if (snap.exists()) {
                    const players = snap.val();
                    for(let uid in players) {
                        if (players[uid].teamSlot && players[uid].playerSlot) {
                            occupiedSlots.add(`${players[uid].teamSlot}-${players[uid].playerSlot}`);
                        }
                    }
                }
                
