                    } else {
                        transactions.forEach(t => {
                            const amt = parseFloat(t.amount || 0);
                            const type = (t.type || '').toLowerCase();
                            let isCr = amt > 0 || (amt === 0 && (type.includes('deposit') || type.includes('win') || type.includes('bonus')));
                            
                            let dateStr = 'Recent';
                            if(t.timestamp) {
                                const d = new Date(t.timestamp);
